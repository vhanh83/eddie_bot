<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro" />

    <!-- MATERIALS -->
    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
    </material>

    <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <!-- BASE LINK (Gốc đặt tại trung điểm 2 bánh xe trên mặt đất) -->
    <link name="base_link">
    </link>

    <!-- CHASSIS BASE (Đế đĩa tròn phía dưới) -->
    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0.035"/> <!-- Đưa đế lên cách mặt đất khoảng tầm bánh xe -->
    </joint>

    <link name="chassis">
        <!-- Đĩa tròn tầng 1 (Base Plate) -->
        <visual>
            <origin xyz="0 0 0.01" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.225"/> <!-- Đĩa Eddie bán kính ~22.5cm -->
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.01" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.225"/>
            </geometry>
        </collision>

        <!-- Đĩa tròn tầng 2 (Top Plate) -->
        <visual>
            <origin xyz="0 0 0.20" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.225"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.20" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.01" radius="0.225"/>
            </geometry>
        </collision>

        <!-- Cột chống đĩa (4 Cột nhôm) -->
        <visual>
            <origin xyz="0.12 0.12 0.105" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.18" radius="0.008"/>
            </geometry>
            <material name="black"/>
        </visual>
        <visual>
            <origin xyz="-0.12 0.12 0.105" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.18" radius="0.008"/>
            </geometry>
            <material name="black"/>
        </visual>
        <visual>
            <origin xyz="0.12 -0.12 0.105" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.18" radius="0.008"/>
            </geometry>
            <material name="black"/>
        </visual>
        <visual>
            <origin xyz="-0.12 -0.12 0.105" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.18" radius="0.008"/>
            </geometry>
            <material name="black"/>
        </visual>

        <xacro:inertial_cylinder mass="3.5" length="0.20" radius="0.225">
            <origin xyz="0 0 0.10" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <!--
    <gazebo reference="chassis">
        <material>Gazebo/White</material>
    </gazebo> -->
    <!-- BÁNH TRÁI (LEFT WHEEL) -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 0.19 0.03" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder length="0.03" radius="0.065"/> <!-- Bánh Eddie bán kính ~6.5cm -->
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.03" radius="0.065"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.3" length="0.03" radius="0.065">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <!-- <gazebo reference="left_wheel">
        <material>Gazebo/Blue</material>
    </gazebo> -->
    <!-- BÁNH PHẢI (RIGHT WHEEL) -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -0.19 0.03" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder length="0.03" radius="0.065"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.03" radius="0.065"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.3" length="0.03" radius="0.065">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
     <!-- <gazebo reference="right_wheel">
        <material>Gazebo/Blue</material>
    </gazebo> -->
    <!-- BÁNH HƯỚNG TRƯỚC (FRONT CASTER WHEEL) -->
    <joint name="front_caster_wheel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="front_caster_wheel"/>
        <origin xyz="0.16 0 -0.045" rpy="0 0 0"/>
    </joint>

    <link name="front_caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="0.05" radius="0.025">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>
    <!-- <gazebo reference="front_caster_wheel">
        <material>Gazebo/Black</material>
        <mu1 value="0.001"/>
        <mu2 value="0.001"/>
    </gazebo> -->
    <!-- BÁNH HƯỚNG SAU (REAR CASTER WHEEL) -->
    <joint name="rear_caster_wheel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="rear_caster_wheel"/>
        <origin xyz="-0.16 0 -0.045" rpy="0 0 0"/>
    </joint>

    <link name="rear_caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="0.05" radius="0.025">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>
     <!-- <gazebo reference="rear_caster_wheel">
        <material>Gazebo/Black</material>
        <mu1 value="0.001"/>
        <mu2 value="0.001"/>
    </gazebo> -->
    
</robot>